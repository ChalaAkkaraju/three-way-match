# ---------------------------------------------------------------------------
# Reading real invoice PDFs needs a model API key. Set EXACTLY ONE of the two
# blocks below. Without either, the app still runs the whole synthetic corpus
# and the reviewer UI simply reports that uploads are disabled.
# ---------------------------------------------------------------------------

# Option A -- Anthropic directly. Shortest path to the model, separate billing.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5           # optional override

# Option B -- OpenRouter, if you already keep credit there.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=                         # optional; blank = pick a
#                                           #   file-capable Claude model from
#                                           #   OpenRouter's own catalogue
# OPENROUTER_PDF_ENGINE=native              # native | cloudflare-ai | mistral-ocr
#   native        the model reads the PDF itself, billed as input tokens.
#                 Matches what the Anthropic path does. Default.
#   cloudflare-ai free, but converts the PDF to markdown first, so the model
#                 never sees the page. Weak on scans and on layout, and an
#                 invoice line table is layout.
#   mistral-ocr   a real OCR pass, charged per page.

# If both keys are set, Anthropic wins.

# Railway sets PORT itself. Only needed for local runs on a different port.
# PORT=8000

# ---------------------------------------------------------------------------
# Retrieval (the investigation agent)
# ---------------------------------------------------------------------------
# Embeddings come from OpenRouter and are cached on disk by content hash.
# Without a key, search falls back to BM25 alone and says so rather than
# pretending it is doing hybrid retrieval.
# OPENROUTER_EMBED_MODEL=openai/text-embedding-3-small
# EMBEDDING_CACHE=data/embeddings.json
